{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3030",
    "dev:safe": "npm run test:unit && npm run dev",
    "build": "npx tsx scripts/ensure-db.ts && next build",
    "start": "next start -p 3030",
    "test": "playwright test",
    "test:iphone-14-plus": "playwright test --project=\"iPhone 14 Plus\"",
    "test:iphone-17-air": "playwright test --project=\"iPhone 17 Air\"",
    "test:iphone": "playwright test --project=\"iPhone 14 Plus\" --project=\"iPhone 17 Air\"",
    "test:generate-iphone-14-plus": "npx tsx scripts/generate-iphone-14-plus-tests.ts",
    "test:generate-iphone-17-air": "npx tsx scripts/generate-iphone-17-air-tests.ts",
    "test:unit": "npx tsx scripts/statement-generator.test.ts && npx tsx scripts/pdf-generator.test.ts && npx tsx scripts/dashboard2-assets.test.ts && npx tsx scripts/payment-html.test.ts",
    "test:dashboard2": "playwright test e2e/dashboard2-face-id.spec.ts e2e/dashboard2-george-key.spec.ts e2e/dashboard2-payment-html.spec.ts e2e/dashboard2-payment-history.spec.ts --project=chromium",
    "test:payment-html": "npx tsx scripts/payment-html.test.ts && playwright test e2e/dashboard2-payment-html.spec.ts e2e/dashboard2-payment-history.spec.ts --project=chromium",
    "lint": "eslint .",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "cap:build": "npm run build && npx cap sync",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx tsx --env-file=.env.local scripts/seed-users.ts",
    "db:seed-larsen-q2": "npx tsx --env-file=.env.local scripts/seed-larsenevans-q2.ts",
    "db:backfill-pdf-url": "npx tsx --env-file=.env.local scripts/backfill-pdf-url.ts",
    "db:setup-supabase": "npx tsx --env-file=.env.local scripts/setup-supabase-env.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@radix-ui/react-label": "^2.1.8",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/blob": "^2.4.1",
    "better-auth": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.2",
    "idb": "^8.0.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.3.11",
    "pg": "^8.21.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@next/env": "^16.2.9",
    "@next/eslint-plugin-next": "^16.2.9",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@tauri-apps/cli": "^2.11.3",
    "@types/node": "^24",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.30.6",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.2.9",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "5.7.3"
  }
}
