// Prisma Schema for George Banking App
// Database: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  accounts      Account[]
  transactions  Transaction[]  @relation("UserTransactions")
  contacts      RecipientContact[] @relation("UserContacts")
  sessions      Session[]
  statement     Statement[]
  
  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  token        String   @unique
  createdAt    DateTime @default(now())
  
  @@index([userId])
  @@index([token])
}

// ============================================
// ACCOUNTS & BALANCES
// ============================================

model Account {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   // e.g., "Main Account", "Savings"
  accountNumber String // Bank account number (not IBAN)
  iban        String?  // International Bank Account Number
  bic         String?  // Bank Identifier Code
  currency    String   @default("EUR") // ISO currency code
  balance     Float    @default(0) // Current balance
  availableBalance Float? // Available balance (balance - holds)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  transactions Transaction[]
  statements   Statement[]
  
  @@unique([userId, accountNumber])
  @@index([userId])
}

// ============================================
// RECIPIENT CONTACTS
// ============================================

model RecipientContact {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  name      String   // Recipient name
  iban      String   // Normalized IBAN (uppercase, no spaces)
  bic       String?  // BIC/SWIFT code
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Unique constraint: user can save each IBAN only once
  @@unique([userId, iban])
  @@index([userId])
  @@index([iban])
}

// ============================================
// TRANSACTIONS
// ============================================

model Transaction {
  id              String   @id @default(cuid())
  
  // Source account
  accountId      String
  account        Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  // User (owner of the transaction)
  userId         String
  user           User    @relation("UserTransactions", fields: [userId], references: [id], onDelete: Cascade)
  
  // Transaction history
  history        TransactionHistory[]

  // Transaction type
  type           String   @default("OUTGOING") // OUTGOING, INCOMING, INTERNAL
  
  // Transaction status
  status         String   @default("PENDING") // PENDING, COMPLETED, FAILED, CANCELLED
  
  // New structured fields for QR payments
  recipientName     String?  // Recipient name
  recipientIban     String?  // Recipient IBAN
  recipientBic      String?  // Recipient BIC
  
  // Payment symbols (Variable, Constant, Specific)
  variableSymbol    String?  // VS - Variable Symbol
  constantSymbol    String?  // KS - Constant Symbol
  specificSymbol    String?  // ŠS - Specific Symbol
  
  // Additional payment information
  note              String?  // Payment note (max 140 characters)
  paymentReference  String?  // Payment reference
  dueDate           DateTime? // Due date for payment
  
  // QR code information
  qrFormat          String?  // 'pay-by-square' | 'epc-sepa'
  
  // Legacy field for backward compatibility
  // Old format: "recipient|iban|bic|amount|currency|vs|ks|ss|note"
  legacyData        String?
  
  // Transaction amounts
  amount           Float    // Transaction amount
  currency         String   @default("EUR") // ISO currency code
  fee              Float    @default(0) // Transaction fee
  totalAmount      Float?   // Total amount (amount + fee)
  
  // Balance information
  balanceBefore    Float?   // Balance before transaction
  balanceAfter     Float?   // Balance after transaction
  
  // Timestamps
  transactionDate  DateTime @default(now()) // When transaction was created
  processedDate    DateTime? // When transaction was processed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Idempotency
  idempotencyKey   String?  @unique // Prevent duplicate transactions
  
  // Metadata
  description       String?  // Transaction description
  category          String?  // Transaction category
  tags             String[] @default([]) // User-defined tags
  
  // For demo/testing
  isDemo           Boolean  @default(true) // Mark as demo/test transaction
  
  @@index([accountId])
  @@index([userId])
  @@index([transactionDate])
  @@index([status])
  @@index([type])
}

// ============================================
// TRANSACTION HISTORY & STATEMENTS
// ============================================

model TransactionHistory {
  id           String   @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  action        String   // CREATE, UPDATE, DELETE, etc.
  changes       Json?    // Changes made in this history entry
  userId        String?  // User who made the change
  timestamp     DateTime @default(now())
  
  @@index([transactionId])
  @@index([timestamp])
}

model Statement {
  id          String   @id @default(cuid())
  accountId   String
  account     Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart  DateTime // Statement period start
  periodEnd    DateTime // Statement period end
  generatedAt  DateTime @default(now())
  filePath     String?  // Path to generated PDF
  fileUrl      String?  // URL to download PDF
  
  @@unique([accountId, periodStart, periodEnd])
  @@index([accountId])
  @@index([userId])
  @@index([generatedAt])
}

// ============================================
// SYSTEM & AUDIT
// ============================================

model AuditLog {
  id         String   @id @default(cuid())
  action     String   // Action performed
  entityType String   // Entity type (User, Account, Transaction, etc.)
  entityId   String   // Entity ID
  userId     String?  // User who performed the action
  metadata   Json?    // Additional metadata
  ipAddress  String?  // IP address of request
  userAgent  String?  // User agent
  timestamp  DateTime @default(now())
  
  @@index([userId])
  @@index([entityType, entityId])
  @@index([timestamp])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique // Configuration key
  value     Json     // Configuration value
  updatedAt DateTime @updatedAt
  updatedBy String?  // User who last updated
  
  @@index([key])
}
